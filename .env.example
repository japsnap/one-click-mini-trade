# Copy this file to .env and fill the values. Never commit .env.
# Main account address (Aster's "user": the wallet that owns the margin).
ASTER_USER=
# API wallet address (Aster's "signer": the agent you created on the Aster API wallet page).
ASTER_SIGNER=
# Private key of the API wallet above. Lives only on the server.
ASTER_SIGNER_PRIVATE_KEY=
# false = trial mode (plans only, nothing is sent). true = real orders.
LIVE_TRADING=false
# Largest ticket (USD margin) the server will send in live mode.
MAX_LIVE_TICKET_USD=10
# Optional builder attribution, e.g. Blackboard's builder address and a fee rate as a decimal fraction (0.0001 = 0.01%).
ASTER_BUILDER_ADDRESS=
ASTER_BUILDER_FEE_RATE=
# Aster futures API host. Empty means https://fapi.asterdex.com
ASTER_BASE_URL=
