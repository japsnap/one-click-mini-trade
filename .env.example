# One-click mini trade: settings for the server.
# Fill the three empty lines after the = sign. No spaces, no quotes.

# Blackboard Settings -> Account: the embedded EVM address (starts with 0x)
ASTER_USER=
# The Aster API wallet address you approved (starts with 0x)
ASTER_SIGNER=
# That API wallet's private key (0x plus 64 characters)
ASTER_SIGNER_PRIVATE_KEY=

# Leave these as they are. LIVE_TRADING stays false until Shota says "go live".
LIVE_TRADING=false
MAX_LIVE_TICKET_USD=10
# Blackboard's builder code, so the trade counts as Blackboard volume (Blackboard docs, Aster API page)
ASTER_BUILDER_ADDRESS=0xecD0674915473B0F2D9061dc6a004f18E29a882E
ASTER_BUILDER_FEE_RATE=0.00025
ASTER_BASE_URL=https://fapi.asterdex.com
